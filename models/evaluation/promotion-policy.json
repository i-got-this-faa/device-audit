{
  "schema_version": "device-audit.promotion-policy.v1",
  "policy_version": "fed10.v1",
  "declared_on": "2026-11-28",
  "declared_before_candidates": true,
  "requires_evaluation_policy": "ml05.v1",
  "comparison": "candidate point estimate against the active model's point estimate on identical held-out examples",
  "regression_gates": [
    {"id": "active_average_precision", "metric": "average_precision", "higher_is_better": true, "max_degradation": 0.0},
    {"id": "active_roc_auc", "metric": "roc_auc", "higher_is_better": true, "max_degradation": 0.005},
    {"id": "active_event_recall", "metric": "event_recall_within_horizon", "higher_is_better": true, "max_degradation": 0.02},
    {"id": "active_window_fpr_degraded", "metric": "window_false_positive_rate_degraded", "higher_is_better": false, "max_degradation": 0.001},
    {"id": "active_window_fpr_critical", "metric": "window_false_positive_rate_critical", "higher_is_better": false, "max_degradation": 0.0003},
    {"id": "active_device_false_alarm", "metric": "never_positive_device_alert_fraction", "higher_is_better": false, "max_degradation": 0.01}
  ]
}
