{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://device-audit.invalid/contracts/federated-v1.schema.json",
  "title": "Off-chain federated round, update and promotion v1",
  "oneOf": [
    {
      "$ref": "#/$defs/round"
    },
    {
      "$ref": "#/$defs/update"
    },
    {
      "$ref": "#/$defs/promotion"
    }
  ],
  "$defs": {
    "round": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "device-audit.federated-round.v1"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "round_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "base_model_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "base_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "feature_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "parameter_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "opened_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "min_participants": {
          "type": "integer",
          "minimum": 2,
          "maximum": 128
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "device_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "signing_key_id": {
                "type": "string",
                "pattern": "^ed25519:[0-9a-f]{64}$"
              },
              "eligibility": {
                "enum": [
                  "eligible",
                  "ineligible"
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "enum": [
                      "revoked",
                      "incompatible_features",
                      "insufficient_local_data",
                      "not_authorized"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "device_id",
              "signing_key_id",
              "eligibility",
              "reason"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "eligibility": {
                      "const": "eligible"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reason": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "minItems": 2,
          "maxItems": 128
        }
      },
      "required": [
        "schema_version",
        "deployment_id",
        "round_id",
        "base_model_version",
        "base_model_sha256",
        "candidate_id",
        "feature_version",
        "parameter_count",
        "opened_at",
        "deadline",
        "min_participants",
        "participants"
      ],
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "device-audit.federated-update.v1"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "round_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "base_model_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "base_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "feature_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "signing_key_id": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "weights_base64": {
          "type": "string",
          "minLength": 12,
          "maxLength": 43692,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "update_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "schema_version",
        "deployment_id",
        "round_id",
        "base_model_version",
        "base_model_sha256",
        "candidate_id",
        "feature_version",
        "device_id",
        "signing_key_id",
        "sequence",
        "issued_at",
        "expires_at",
        "sample_count",
        "weights_base64",
        "update_sha256",
        "signature"
      ],
      "additionalProperties": false
    },
    "promotion": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "device-audit.federated-promotion.v1"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "round_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "base_model_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "base_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "feature_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "candidate_model_version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_model_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluation_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "decision": {
          "enum": [
            "promoted",
            "rejected"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "evaluation_failed",
                "insufficient_participants",
                "aggregation_failed",
                "cancelled"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted_participants": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "deployment_id",
        "round_id",
        "base_model_version",
        "base_model_sha256",
        "candidate_id",
        "feature_version",
        "candidate_model_version",
        "candidate_model_sha256",
        "evaluation_sha256",
        "policy_version",
        "decided_at",
        "decision",
        "reason",
        "accepted_participants"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "promoted"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              },
              "candidate_model_version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "candidate_model_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evaluation_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "accepted_participants": {
                "minItems": 2
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "candidate_model_version": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "candidate_model_sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "candidate_model_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "evaluation_failed"
              }
            }
          },
          "then": {
            "properties": {
              "candidate_model_version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "candidate_model_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evaluation_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    }
  }
}
