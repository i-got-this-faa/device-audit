{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "device-audit.v1 telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "collected_at", "source", "metrics"],
  "properties": {
    "schema_version": {"const": "device-audit.v1"},
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "collected_at": {"type": "string", "format": "date-time"},
    "source": {"enum": ["fixture", "endpoint"]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cpu_percent": {"$ref": "#/$defs/percent"},
        "memory_percent": {"$ref": "#/$defs/percent"},
        "disk_used_percent": {"$ref": "#/$defs/percent"},
        "battery_percent": {"$ref": "#/$defs/percent"},
        "temperature_c": {"type": ["number", "null"]},
        "network_latency_ms": {"type": ["number", "null"], "minimum": 0}
      },
      "anyOf": [
        {"required": ["cpu_percent"], "properties": {"cpu_percent": {"type": "number"}}},
        {"required": ["memory_percent"], "properties": {"memory_percent": {"type": "number"}}},
        {"required": ["disk_used_percent"], "properties": {"disk_used_percent": {"type": "number"}}},
        {"required": ["battery_percent"], "properties": {"battery_percent": {"type": "number"}}},
        {"required": ["temperature_c"], "properties": {"temperature_c": {"type": "number"}}},
        {"required": ["network_latency_ms"], "properties": {"network_latency_ms": {"type": "number"}}}
      ]
    }
  },
  "$defs": {
    "percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
  }
}
