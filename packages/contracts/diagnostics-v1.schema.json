{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://device-audit.invalid/contracts/diagnostics-v1.schema.json",
  "title": "Off-chain diagnostic assignments and terminal results v1",
  "oneOf": [
    {
      "$ref": "#/$defs/assignment"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "assignment": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "device-audit.diagnostic-assignment.v1"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "signing_key_id": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "assignment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "probe_id": {
          "enum": [
            "storage_health.v1",
            "system_errors.v1"
          ]
        },
        "arguments": {
          "type": "object",
          "properties": {
            "component_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lookback_seconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_entries": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "component_id",
            "lookback_seconds",
            "max_entries"
          ],
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "properties": {
            "wall_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          },
          "required": [
            "wall_seconds",
            "max_output_bytes"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "schema_version",
        "deployment_id",
        "device_id",
        "signing_key_id",
        "sequence",
        "issued_at",
        "expires_at",
        "assignment_id",
        "probe_id",
        "arguments",
        "budget",
        "signature"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "probe_id": {
                "const": "storage_health.v1"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "properties": {
                  "component_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "lookback_seconds": {
                    "type": "null"
                  },
                  "max_entries": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "arguments": {
                "properties": {
                  "component_id": {
                    "type": "null"
                  },
                  "lookback_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  "max_entries": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  }
                }
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "device-audit.diagnostic-result.v1"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "signing_key_id": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "assignment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "assignment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "state": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "expired",
            "rebooted",
            "rejected"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "probe_error",
                "budget_exhausted",
                "permission_denied",
                "cancel_requested",
                "deadline_exceeded",
                "agent_restarted",
                "assignment_denied"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reference_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              }
            },
            "required": [
              "reference_id",
              "sha256",
              "size_bytes"
            ],
            "additionalProperties": false
          },
          "maxItems": 8
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "schema_version",
        "deployment_id",
        "device_id",
        "signing_key_id",
        "sequence",
        "issued_at",
        "expires_at",
        "assignment_id",
        "assignment_sha256",
        "boot_id",
        "started_at",
        "finished_at",
        "state",
        "reason",
        "evidence",
        "signature"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              },
              "started_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "probe_error",
                  "budget_exhausted",
                  "permission_denied"
                ]
              },
              "started_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "cancel_requested"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "expired"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "deadline_exceeded"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "rebooted"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "agent_restarted"
              },
              "started_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "assignment_denied"
              },
              "started_at": {
                "type": "null"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
