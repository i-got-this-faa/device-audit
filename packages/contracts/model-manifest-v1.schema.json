{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://device-audit.invalid/contracts/model-manifest-v1.schema.json",
  "title": "Signed model artifact manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "device-audit.model-manifest.v1"
    },
    "model_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "architecture": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "parameter_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "runtime_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "runtime_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "feature_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inference",
          "training"
        ]
      }
    },
    "signing_key_id": {
      "type": "string",
      "pattern": "^ed25519:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "schema_version",
    "model_version",
    "artifact_sha256",
    "architecture",
    "parameter_count",
    "runtime_name",
    "runtime_version",
    "feature_version",
    "features",
    "purposes",
    "signing_key_id",
    "signature"
  ],
  "additionalProperties": false
}
