{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "device-audit.evidence.v1",
  "description": "Provisional #75 contract. See envelopes-v1.md for canonical bytes, semantic validation, trust, time and durable sequence rules. JSON Schema alone does not verify signatures or replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "device_id",
    "signing_key_id",
    "sequence",
    "issued_at",
    "expires_at",
    "payload_schema_version",
    "payload_base64",
    "payload_sha256",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "device-audit.evidence.v1"
    },
    "deployment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "signing_key_id": {
      "type": "string",
      "pattern": "^ed25519:[0-9a-f]{64}(?![\\s\\S])"
    },
    "sequence": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
    },
    "payload_schema_version": {
      "const": "device-audit.telemetry.v2"
    },
    "payload_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 349528,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}(?![\\s\\S])"
    }
  }
}
