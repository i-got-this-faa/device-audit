{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inventory revisions v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "device_id",
        "observed_at",
        "source_reference",
        "inventory",
        "expected_revision"
      ],
      "properties": {
        "schema_version": {
          "const": "device-audit.inventory-update.v1"
        },
        "device_id": {
          "$ref": "#/$defs/id"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_reference": {
          "$ref": "#/$defs/id"
        },
        "inventory": {
          "$ref": "#/$defs/inventory"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "device_id",
        "observed_at",
        "source_reference",
        "inventory",
        "deployment_id",
        "revision",
        "recorded_at",
        "enrollment_sha256",
        "actor_issuer",
        "actor_subject"
      ],
      "properties": {
        "schema_version": {
          "const": "device-audit.inventory-record.v1"
        },
        "device_id": {
          "$ref": "#/$defs/id"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_reference": {
          "$ref": "#/$defs/id"
        },
        "inventory": {
          "$ref": "#/$defs/inventory"
        },
        "deployment_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "enrollment_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$(?![\\s\\S])"
        },
        "actor_issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "actor_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$(?![\\s\\S])"
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/id"
        },
        "network_segment_id": {
          "$ref": "#/$defs/id"
        },
        "components": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "model": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        }
      }
    }
  }
}
